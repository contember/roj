{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		// Symbol.dispose: exec handles are disposable, and ES2022 does not declare it.
		"lib": ["ES2022", "ESNext.Disposable"],
		"types": ["@cloudflare/workers-types"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}
